# Dynamic Environment ID
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=YOUR_DYNAMIC_ENVIRONMENT_ID

# Solana Config
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Firebase Config
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# $RWD (Rewind Static) Solana Token Mint Address (legacy, kept for backward compat)
NEXT_PUBLIC_RWD_TOKEN_ADDRESS=BNyRLdnXZ2ZBhgR6AQiwrJrNCKh5WLGrhub5sPP4ZQmv
RWD_TOKEN_MINT_ADDRESS=BNyRLdnXZ2ZBhgR6AQiwrJrNCKh5WLGrhub5sPP4ZQmv
NEXT_PUBLIC_REAL_TOKEN_ADDRESS=BNyRLdnXZ2ZBhgR6AQiwrJrNCKh5WLGrhub5sPP4ZQmv
REAL_TOKEN_MINT_ADDRESS=BNyRLdnXZ2ZBhgR6AQiwrJrNCKh5WLGrhub5sPP4ZQmv

# Solana Treasury Private Key (Base58 string or byte array)
TREASURY_SOLANA_PRIVATE_KEY=YOUR_SOLANA_TREASURY_PRIVATE_KEY

# Minimum $RWD Token Requirement to play/withdraw (Set to 0 for no minimum)
NEXT_PUBLIC_MIN_RWD_REQUIRED=0
NEXT_PUBLIC_MIN_REAL_REQUIRED=0

# --- Pay-to-Play: Client-facing (browser needs these to build the payment tx) ---
NEXT_PUBLIC_GAME_FEE_AMOUNT=10
# Treasury wallet that receives game fees (same address for both networks)
NEXT_PUBLIC_GAME_FEE_WALLET=YOUR_GAME_FEE_TREASURY_WALLET
# RWD Token Contract Address per network (mint)
NEXT_PUBLIC_RWD_MINT_DEVNET=YOUR_RWD_MINT_DEVNET
NEXT_PUBLIC_RWD_MINT_MAINNET=YOUR_RWD_MINT_MAINNET

# --- Pay-to-Play: Server-only (authoritative, never exposed to browser) ---
GAME_FEE_AMOUNT=10
GAME_FEE_WALLET=YOUR_GAME_FEE_TREASURY_WALLET
RWD_MINT_DEVNET=YOUR_RWD_MINT_DEVNET
RWD_MINT_MAINNET=YOUR_RWD_MINT_MAINNET

# Session secret for HMAC-signing game tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
GAME_SESSION_SECRET=GENERATE_A_SECRET_AND_PASTE_HERE

# --- Admin Panel Authentication (Server-only, never saved to database) ---
ADMIN_USERNAME=YOUR_ADMIN_USERNAME
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
